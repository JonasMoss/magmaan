(* ===========================================================================
   Mplus input-file grammar, implemented increments 1–5
   ---------------------------------------------------------------------------
   Normative for the implemented continuous/categorical parse::Mplus* frontend. mplus.md
   owns the target and increments; mplus_source_inventory.md
   owns the evidence, cited here by rule ID in brackets ([LX03]). Source:
   Mplus User's Guide v8 (2017) and the language addenda 8.1 to 9.1.

   The reader classifies every command and option [CL01-CL32]; lowering
   implements single/multiple-group continuous/categorical linear SEM,
   growth, constraints/indirect effects and typed data plans. Out-of-family
   constructs are rejected or reported with source spans; nothing is skipped
   silently.

   Notation as in grammar.ebnf (W3C-style EBNF). Matching of command, option
   and setting names, keywords and variable names is case-insensitive
   [LX04]. Abbreviations are resolved after tokenizing, by name resolution
   rules stated in comments, not by the productions.
   ===========================================================================*)


(* === Physical lines and comments ==========================================
   Lines matter twice: a command starts a line [LX01], and a MODEL label
   applies to the items of its own line [LB02]. Tabs are blanks. *)

input_file          ::= line*
line                ::= BLANK* line_content? NEWLINE
line_content        ::= (token | BLANK | block_comment)+ line_comment?
                      | line_comment
line_comment        ::= '!' (char - '*') char*  |  '!'
block_comment       ::= '!*' (char | NEWLINE)* '*!'
(* A block comment ends at the first '*!'. It must open at a line start or
   close on its opening line; a block opened after code that closes on a
   later line is rejected, because Mplus 9.1 then also drops the preceding
   code [LX05]. Non-TITLE/non-comment content beyond 90 columns is rejected with its span,
   because 9.1 truncates it [LX02]. *)


(* === Tokens =============================================================== *)

token               ::= name | number | punct
name                ::= letter (letter | digit | '_')*
(* The guide limits names to 8 characters, but 9.1 accepts longer names and
   keeps them distinct; full names are compared [NM01]. *)
number              ::= digit+ ('.' digit*)? | '.' digit+
punct               ::= ':' | ';' | ',' | '-' | '*' | '@' | '(' | ')' | '['
                      | ']' | '{' | '}' | '|' | '$' | '#' | '%' | '=' | '~'
                      | '&' | '/' | '+' | '<' | '>' | other_symbol
letter              ::= [A-Za-z]
digit               ::= [0-9]
BLANK               ::= ' ' | '\t'


(* === Commands ============================================================= *)

command             ::= command_head command_body
command_head        ::= LINE_START BLANK* command_word ':'
command_word        ::= 'TITLE' | 'DATA' data_qualifier? | 'VARIABLE'
                      | 'DEFINE' | 'ANALYSIS' | 'MODEL' model_qualifier?
                      | 'OUTPUT' | 'SAVEDATA' | 'PLOT' | 'MONTECARLO'
(* Command words may be shortened to four or more letters [LX03]. Commands
   appear in any order; DATA and VARIABLE are required [LX01]. A repeated
   command other than MODEL label sections is rejected. *)
data_qualifier      ::= 'IMPUTATION' | 'WIDETOLONG' | 'LONGTOWIDE'
                      | 'TWOPART' | 'MISSING' | 'SURVIVAL' | 'COHORT'
model_qualifier     ::= 'CONSTRAINT' | 'INDIRECT' | 'TEST' | 'PRIORS'
                      | ('POPULATION' | 'COVERAGE' | 'MISSING')
                        ('-' group_label)?
                      | group_label
group_label         ::= name
(* A `MODEL label:` section is a group section only when GROUPING or FILE/NGROUPS declares
   that label; otherwise it is rejected, because since 8.9 such sections can
   denote time points of a longitudinal invariance model [CL31]. *)
command_body        ::= title_body | option_body | model_body | opaque_body

title_body          ::= free_text
(* TITLE text runs to the next command head. A command word followed by a
   colon ends it; other colons are text [LX06, probe P-LX3]. *)

opaque_body         ::= free_text
(* DEFINE, qualified DATA transformations, MODEL PRIORS/POPULATION/COVERAGE/
   MISSING and MONTECARLO are delimited and rejected; MODEL TEST and execution
   commands are reported [CL06, CL16, CL28-CL32]. MODEL CONSTRAINT and
   INDIRECT use their dedicated productions below. *)


(* === Options (DATA, VARIABLE, ANALYSIS, OUTPUT, SAVEDATA, PLOT) ===========
   An option ends at ';'; several may share a line [LX01]. IS, ARE and '='
   are interchangeable [LX07]. Option names may be shortened to four or more
   letters; a setting must be its complete word or its exact documented stem,
   never an intermediate prefix [LX03, CL rules]. *)

option_body         ::= option*
option              ::= option_name (assign? option_value)? ';'
option_name         ::= name
assign              ::= 'IS' | 'ARE' | '='
option_value        ::= (token - ';')+
(* The option name is classified before its value is read [CL01-CL32].
   Values of imported options are parsed by the productions below; values
   of other options are delimited only. *)

(* VARIABLE: NAMES [CL07, NM02] *)
names_value         ::= name_generator (list_sep name_generator)*
name_generator      ::= name | name '-' name
list_sep            ::= ','? BLANK* | BLANK+ ','? BLANK*
(* A NAMES range generates names from a shared stem with a numeric suffix,
   keeping the endpoint digit width (y08-y11), or a single-letter suffix
   (itema-itemd). Other shapes are rejected [NM02]. Duplicate names are
   rejected. *)

(* VARIABLE: USEVARIABLES [CL08, NM03] *)
usevariables_value  ::= ('ALL' list_sep)? variable_range (list_sep variable_range)*
variable_range      ::= name | name '-' name
(* Here a range selects NAMES variables by position, from the first name
   to the second; a range whose first endpoint comes later is an error
   [NM03]. ALL first means every NAMES variable. The USEVARIABLES order
   becomes the analysis order, which MODEL ranges follow. *)

(* ANALYSIS: TYPE, MODEL; settings are names resolved by stem [CL17,
   CL19-CL21] *)
settings_value      ::= setting+
setting             ::= name


(* === MODEL statements (increment 1: single group, continuous) ============
   A statement ends at ';' and may span lines. A parenthesized label applies
   to the items of its own line only; at most one label per line [LB02].
   Tokens after a label on the same line, other than the closing ';', are
   rejected [LB03]. *)

model_body          ::= model_statement*
model_statement     ::= relation | variance_statement | mean_statement
                      | scale_statement | bar_statement | section_marker
relation            ::= lhs_list relation_op rhs_lines ';'
relation_op         ::= 'BY' | 'ON' | 'WITH' | 'PON' | 'PWITH'
lhs_list            ::= variable_range+
rhs_lines           ::= rhs_line+
rhs_line            ::= rhs_item+ line_label?
(* rhs_line is a maximal run of items on one physical line. *)
rhs_item            ::= variable_range modifier?
modifier            ::= '*' signed_number? | '@' signed_number?
signed_number       ::= '-'? number
(* '*' frees (with an optional start), '@' fixes [LB01]. After a range the
   modifier applies to every element [LB01]. A bare '*' frees at the
   default start (no Starts entry); a bare '@' is rejected, because Mplus
   fixes at its data-dependent default start [LB01]. A later mention of the
   same parameter, in the same or a later statement, overrides an earlier
   one, including the default marker fix [LB07, MS02]. *)

line_label          ::= '(' label_group+ ')'
label_group         ::= label_atom | label_atom '-' label_atom
label_atom          ::= number | name
(* Numbers are equality sets, names parameter labels; both are global
   across groups, and parameters sharing one are equal [LB04, LB06, MG07].
   A list has one entry per item; with a left-hand list, one group per
   left-hand element or a single list assigned row by row [LB05]. A label on
   a fixed parameter is not a usable label [LB06]. Mixing numbers and names
   in one label, '(*label)' ESEM sets and other forms are rejected [MS09]. *)

variance_statement  ::= rhs_lines ';'
mean_statement      ::= '[' (rhs_item | threshold_item)+ ']' line_label? ';'
threshold_item      ::= threshold_range modifier?
threshold_range     ::= threshold_name ('-' threshold_name)?
threshold_name      ::= name '$' integer
categorical_value   ::= variable_range+
parameterization_value ::= 'DELTA' | 'THETA'
(* CT01–CT04: threshold indices start at one. A range either spans variables
   at one threshold index or thresholds of one variable. DELTA scale equalities
   and fixed non-unit scales are retained in response coordinates (TASK-53.1). *)

scale_statement     ::= '{' rhs_item+ '}' line_label? ';'
(* CT04: DELTA response scales; THETA uses residual variances instead. *)

bar_statement       ::= name name? name? name? '|' rhs_item+ ';'
(* GR01–GR06: polynomial growth with one to four factors. GR07 rejects
   random effects (ON/PON/BY/XWITH/AT) and a single bare outcome.
   Explicit mentions override generated growth defaults in either order. *)

section_marker      ::= '%' (token - '%')+ '%'
(* Mixture and multilevel sections are rejected [MS10]. *)

(* Semantic rules applied after parsing, in order:
   1. Resolve names: observed names against the analysis order [NM03];
      latent names are those on the left of BY [NM04]. A latent variable on
      the right of BY must be defined earlier [MS03].
   2. Expand ranges and left-hand lists into statements [NM05, MS05, MS06].
   3. Attach labels and equalities by line [LB02-LB06].
   4. Apply the default rules DF01-DF13 and the marker rule MS02, and
      materialize every default parameter explicitly. All final dependent
      variables that are not factor indicators, observed or latent, get
      free residual covariances [DF08-DF10].
   5. Honor NOMEANSTRUCTURE only with an explicit INFORMATION = EXPECTED;
      otherwise reject it, since Mplus would ignore it [MS11].
   6. Explicit moments must bring every observed independent variable into
      the joint model [MS08]. Each variance or mean mention brings its x
      into the model; WITH brings both endpoints. Complete mentions add
      free x means, variances and default pairwise covariances (P-MS08b).
      Partial mentions are rejected with the complete variance statement.
      Group overrides must preserve the overall conditioning convention.
      Reject every construct outside the accepted family, with its span. *)

(* === Multiple groups (increment 2) ======================================== *)
grouping_value      ::= name '(' grouping_pair (list_sep grouping_pair)* ')'
grouping_pair       ::= signed_number '=' group_label
(* MG01–MG08: codes must be integral, including negative integers and decimal
   spellings of integers (P-MG11/P-MG12). Compare numerically, reject duplicate
   codes/labels, and order groups by ascending code. Count and unlabelled forms
   remain rejected; write explicit code = label pairs. Repeated MODEL label sections apply cumulatively in source
   order; multi-label heads are rejected (P-MG9/P-MG10).
   Overall MODEL is materialized in each group. Observed BY loadings and
   indicator intercepts share reserved .mgN. identifiers; these are generated,
   distinct from user equality-number .eqN. identifiers. Other defaults are
   free per group; latent means are zero in group 1 and free thereafter.
   Group mentions release the corresponding default equality/marker unless
   explicitly fixed or labelled. Group-only rows are fixed zero elsewhere.
   IV01–IV05: one CONFIGURAL/METRIC/SCALAR requires GROUPING and an overall
   first-order-BY-only model. Configural frees loadings/intercepts, metric
   shares loadings, scalar shares both; latent means are zero except in later
   scalar groups. Variance identification fixes variances in all configural
   groups and only the first metric/scalar group. *)

(* === Data description (increment 5; CL02–CL03, CL09, DA01–DA06) =========== *)
data_file           ::= ('(' group_label ')' assign)? file_path
file_path           ::= quoted_path | bare_path
format_value        ::= 'FREE' | format_group | format_item+
format_group        ::= '(' format_item (','? format_item)* ')'
format_item         ::= integer? (format_group | numeric_field | skip | tab | '/')
numeric_field       ::= 'F' integer ('.' integer)? | integer '.' integer
skip                ::= 'X'
tab                 ::= 'T' integer
integer             ::= digit+
data_type           ::= ('INDIVIDUAL' | 'COVARIANCE' | 'CORRELATION'
                        | 'FULLCOV' | 'FULLCORR' | 'MEANS' | 'STDEVIATIONS')+
missing_value       ::= '.' | '*' | 'BLANK'
                      | (('ALL' | variable_range+) '(' missing_numbers ')')+
missing_numbers     ::= signed_number ('-' signed_number)?
                        (list_sep signed_number ('-' signed_number)?)*
(* FORMAT is flattened to bounded field/skip/tab/record operations. Summary
   inputs are free format, require positive NOBSERVATIONS per group, and
   allow exactly one matrix type, optionally MEANS and STDEVIATIONS (the
   latter with correlation only). Separate FILE labels define group order;
   NGROUPS defines g1, g2, ... for summary inputs. Neither combines with
   GROUPING. Data groups use reserved column .mplus_group and label-valued
   triple group labels, with no numeric codes. Summary inputs without MEANS
   have no mean structure and reject explicit bracket mentions (P-DA3).
   Correlation without SD has unit variances (P-DA4). Summary matrices use
   divisor N-1 on input and are rescaled by (N-1)/N for ML (P-DA5).
   Numeric missing flags
   are compared after fixed-format implied-decimal scaling (P-DA2). *)

(* === Constraints and indirect effects (increment 4) ===================== *)
constraint_body     ::= (new_statement | equality_statement | do_statement
                        | plot_statement)*
new_statement       ::= 'NEW' '(' (name_generator ('*' signed_number)?)+ ')' ';'
equality_statement  ::= mplus_expr ('=' | '<' | '>') mplus_expr ';'
mplus_expr          ::= expr  (* shared expression grammar; ** maps to ^,
                                 PHI maps to pnorm; names case-insensitive *)
do_statement        ::= 'DO' '(' integer ',' integer ')' constraint_body
plot_statement      ::= ('LOOP' | 'PLOT') (token - ';')* ';'
indirect_statement  ::= name ('IND' name+ | 'VIA' name name) ';'
(* NEW ranges require matching numeric suffixes (unlike the letter-suffix
   NAMES form); expansion is bounded. NEW quantities defined on the left are derived. Otherwise
   NEW supplies auxiliary free coordinates (start 0.5), with no moment cell.
   Equality constraints must identify these coordinates. Inequalities are
   deliberately refused (CN01/project/scope.md). LOOP/PLOT and MODEL TEST
   are reported. Causal-effect value and MOD forms are rejected (CN05). *)
