# DEV-ONLY Makevars — NOT shipped, NOT vendored. `just r-dev` mirrors r-package/
# into r-package/build-rdev/ (minus the vendored core/, magmaan/, cpp/third_party/ trees) and
# swaps this file in as r-package/build-rdev/src/Makevars, so the generated portable
# r-package/src/Makevars is never touched. Instead of recompiling the whole
# vendored C++ library on every install, it compiles only the R glue and links it
# against the prebuilt opt-preset libmagmaan.a that `cmake --build` produced.
#
# MAGMAAN_ROOT is exported by the `r-dev` recipe (the repo root). The fallback
# `$(CURDIR)/../..` is only correct when this file sits at <repo>/r-package/src;
# from r-package/build-rdev/src it would resolve to r-package/build-rdev/, so `?=` lets the env win.
MAGMAAN_ROOT ?= $(abspath $(CURDIR)/../..)
MAGMAAN_PRESET ?= opt
MAGMAAN_BUILD ?= $(MAGMAAN_ROOT)/cpp/build/$(MAGMAAN_PRESET)
MAGMAAN_LIB  := $(MAGMAAN_BUILD)/libmagmaan.a
MAGMAAN_PORT_LIB := $(MAGMAAN_BUILD)/libport.a
MAGMAAN_QUADPACK_LIB := $(MAGMAAN_BUILD)/libquadpack.a
MAGMAAN_NLOPT_LIB := $(MAGMAAN_BUILD)/_deps/nlopt-build/libnlopt.a
MAGMAAN_WITH_CERES_R ?= 0
MAGMAAN_WITH_IPOPT_R ?= 0
MAGMAAN_IPOPT_CPPFLAGS := $(shell pkg-config --cflags ipopt 2>/dev/null)
MAGMAAN_IPOPT_LIBS := $(shell pkg-config --libs ipopt 2>/dev/null)
MAGMAAN_CONFIG_STAMP := .magmaan-build-config
MAGMAAN_R_CCACHE := $(shell command -v ccache 2>/dev/null)
MAGMAAN_R_CXX ?= $(shell sed -n 's/^CMAKE_CXX_COMPILER:[^=]*=//p' "$(MAGMAAN_BUILD)/CMakeCache.txt")
MAGMAAN_R_CXXFLAGS ?= -O1 -g0 -DNDEBUG -march=native

CXX_STD       = CXX23
PKG_CPPFLAGS  = -I$(MAGMAAN_ROOT)/cpp/include -DEIGEN_MAX_ALIGN_BYTES=64
PKG_CXXFLAGS  = -MMD -MP
# R selects CXX23, which personal Makevars often omit when enabling ccache.
# r-dev supplies the CMake core's compiler so development uses one toolchain.
# Avoid wrapping an already cached command twice.
override CXX = $(if $(findstring ccache,$(MAGMAAN_R_CXX)),,$(MAGMAAN_R_CCACHE)) $(MAGMAAN_R_CXX) $(CXX23STD)
override SHLIB_LD = $(MAGMAAN_R_CXX) $(CXX23STD)
# Keep the numerical core optimized; the large glue TUs need cheap compilation.
# Override in the environment for debugging or performance work, e.g.
# MAGMAAN_R_CXXFLAGS='-O0 -g' just r-dev.
override CXXFLAGS = $(MAGMAAN_R_CXXFLAGS)
# libmagmaan.a links PRIVATEly against libport.a and libnlopt.a in the C++
# CMake build, so the static archive carries unresolved PORT/NLopt symbols.
# The R shared object must pull them in explicitly or it fails to load with an
# undefined symbol. Prefer the fetched NLopt archive and fall back to -lnlopt.
PKG_LIBS      = $(MAGMAAN_LIB) $(MAGMAAN_PORT_LIB) $(MAGMAAN_QUADPACK_LIB) $(if $(wildcard $(MAGMAAN_NLOPT_LIB)),$(MAGMAAN_NLOPT_LIB),-lnlopt)

ifeq ($(MAGMAAN_WITH_CERES_R),1)
PKG_CPPFLAGS += -DMAGMAAN_WITH_CERES
PKG_LIBS     += -lceres -lglog -lgflags
endif

ifeq ($(MAGMAAN_WITH_IPOPT_R),1)
PKG_CPPFLAGS += -DMAGMAAN_WITH_IPOPT $(MAGMAAN_IPOPT_CPPFLAGS)
PKG_LIBS     += $(MAGMAAN_IPOPT_LIBS)
endif

# The r-dev recipe builds the core before invoking R. Real archive prerequisites
# allow a no-op install to skip linking and ensure core changes reach the DLL.
$(SHLIB): $(MAGMAAN_LIB) $(MAGMAAN_PORT_LIB) $(MAGMAAN_QUADPACK_LIB) $(wildcard $(MAGMAAN_NLOPT_LIB)) $(MAGMAAN_CONFIG_STAMP)

.PHONY: FORCE

$(MAGMAAN_CONFIG_STAMP): FORCE
	@tmp="$@.tmp"; \
	printf '%s\n' "MAGMAAN_PRESET=$(MAGMAAN_PRESET)" "MAGMAAN_BUILD=$(MAGMAAN_BUILD)" "MAGMAAN_WITH_CERES_R=$(MAGMAAN_WITH_CERES_R)" "MAGMAAN_WITH_IPOPT_R=$(MAGMAAN_WITH_IPOPT_R)" "CXX=$(CXX)" "CXXFLAGS=$(ALL_CXXFLAGS)" "CPPFLAGS=$(ALL_CPPFLAGS)" > "$$tmp"; \
	if test -r "$@" && cmp -s "$$tmp" "$@"; then rm "$$tmp"; else mv "$$tmp" "$@"; fi

# R only tracks .cpp -> .o. Compiler-generated dependencies also track glue and
# canonical headers, preventing stale ABI objects without recompiling all glue
# after implementation-only core changes. Archive changes only relink the DLL.
$(OBJECTS): $(MAGMAAN_CONFIG_STAMP) Makevars
# R also supplies a .cpp -> .d rule; generate dependencies during compilation
# instead of running a separate preprocessor pass while make reads its inputs.
$(OBJECTS:.o=.d): ;
-include $(OBJECTS:.o=.d)
