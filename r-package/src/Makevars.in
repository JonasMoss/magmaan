# Generated by configure from this portable template. No CMake build is needed.
# USE_C17 in DESCRIPTION keeps the legacy f2c callbacks out of C23 mode.
CXX_STD = CXX23
PKG_CPPFLAGS = -I. -Icore -Ithird_party/port/cport -Ithird_party/quadpack \
  -DMAGMAAN_WITH_PORT -DMAGMAAN_R_PORT_IO -DEIGEN_NO_EXCEPTIONS \
  -DEIGEN_MAX_ALIGN_BYTES=64 @NLOPT_CFLAGS@
PKG_LIBS = @NLOPT_LIBS@
OBJECTS = @OBJECTS@
