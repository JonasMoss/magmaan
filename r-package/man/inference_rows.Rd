\name{inference_rows}
\alias{inference_rows}
\title{Casewise rows of a prepared quadratic}
\description{Extracts casewise contributions in group-block order from a prepared inference quadratic.}
\usage{
inference_rows(quadratic)
}
\arguments{
\item{quadratic}{Prepared quadratic from inference_quadratic.}
}
\value{A matrix of casewise contributions.}
