\name{factor_score_precision}
\alias{factor_score_precision}
\title{Factor-score precision diagnostics}
\description{Computes precision diagnostics for factor scores from a fit and complete raw observations.}
\usage{
factor_score_precision(fit, data)
}
\arguments{
\item{fit}{A fitted magmaan model.}
\item{data}{Observed data frame, named matrix or sample-moment list compatible with the model. FIML requires raw observations.}
}
\value{Native factor-score precision diagnostics.}
