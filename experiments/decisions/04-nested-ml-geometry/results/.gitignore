!structured-mean/production-2026-10-05/timing.csv
!structured-mean/production-2026-10-05/failures.csv
!structured-mean/production-2026-10-05/checks.csv
!structured-mean/production-2026-10-05/decisions.csv
!structured-mean/production-2026-10-05/metadata.csv
