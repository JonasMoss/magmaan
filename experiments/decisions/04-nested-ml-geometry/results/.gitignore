!/*/
*/*/raw/
*/*/progress.csv
*.log

# Smoke attempts are local construction diagnostics; only pilot summaries freeze.
nested-geometry/smoke*/

# Task-73 keeps only frozen summary/provenance; component arrays stay local.
score-diagnostic/smoke*/
score-diagnostic/*/raw/
score-diagnostic/production-replay/
score-diagnostic/production-replay-fixed/

# TASK-75 freezes only registered pilot summaries and pricing provenance.
structured-mean/*/
!structured-mean/pilot-2026-10-05/
structured-mean/pilot-2026-10-05/*
!structured-mean/pilot-2026-10-05/cells.csv
!structured-mean/pilot-2026-10-05/population.csv
!structured-mean/pilot-2026-10-05/rates.csv
!structured-mean/pilot-2026-10-05/paired.csv
!structured-mean/pilot-2026-10-05/timing.csv
!structured-mean/pilot-2026-10-05/failures.csv
!structured-mean/pilot-2026-10-05/checks.csv
!structured-mean/pilot-2026-10-05/decisions.csv
!structured-mean/pilot-2026-10-05/metadata.csv

# Bounded authorized replay: summary/provenance only; raw draws remain local.
!structured-mean/replay-2026-10-05/
structured-mean/replay-2026-10-05/*
!structured-mean/replay-2026-10-05/checks.csv
!structured-mean/replay-2026-10-05/metadata.csv

# Modal raw rows and local fan-out checks are construction diagnostics.
**/raw.rds
local-fanout-*/

# Registered production (Modal, 2026-10-05): summaries and provenance only.
!structured-mean/production-2026-10-05/
structured-mean/production-2026-10-05/*
!structured-mean/production-2026-10-05/cells.csv
!structured-mean/production-2026-10-05/population.csv
!structured-mean/production-2026-10-05/rates.csv
