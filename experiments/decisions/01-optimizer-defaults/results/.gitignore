# Decision evidence is tracked: re-include the lane folders that
# experiments/.gitignore excludes; raw per-fit rows, logs and heartbeats stay local.
!/*/
*/*/raw/
*/*/progress.csv
*.log

# Retain only the frozen paired diagnostic evidence, not exploratory raw runs.
psd-scale/*
!psd-scale/absolute-controls/
psd-scale/absolute-controls/*
!psd-scale/absolute-controls/metadata.csv
!psd-scale/absolute-controls/summary.csv
!psd-scale/relative-final/
psd-scale/relative-final/*
!psd-scale/relative-final/metadata.csv
!psd-scale/relative-final/summary.csv
!psd-scale/comparison/
psd-scale/comparison/*
!psd-scale/comparison/summary.csv
!psd-scale/comparison/family.csv
!psd-scale/comparison/pair.csv
!psd-scale/comparison/changes.csv
!psd-scale/comparison/route.csv
!psd-scale/comparison/route_summary.csv

# Frozen unconstrained normalization pilot; full fits/parameters remain local.
psd-normalization/*
!psd-normalization/pilot/
psd-normalization/pilot/*
!psd-normalization/pilot/metadata.csv
!psd-normalization/pilot/summary.csv
!psd-normalization/pilot/family.csv
!psd-normalization/pilot/paired_changes.csv
!psd-normalization/pilot/changes.csv
!psd-normalization/pilot/invariance.csv
!psd-normalization/pilot/unit_exceptions.csv
!psd-normalization/pilot/transport.csv
!psd-normalization/pilot/transport_failures.csv
!psd-normalization/pilot/input_invariance.csv
!psd-normalization/pilot/accuracy_checks.csv
!psd-normalization/pilot/failures.csv
