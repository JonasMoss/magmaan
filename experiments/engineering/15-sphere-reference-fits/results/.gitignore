*
!.gitignore
# Small frozen evidence for the exploratory reference pilot; raw fits/starts
# and historical runs stay local. No default is selected by these summaries.
!reference-pilot/
reference-pilot/*
!reference-pilot/summary.csv
!reference-pilot/reference_summary.csv
!reference-pilot/references.csv
!reference-pilot/metadata.csv
!reference-pilot/witness_probe.csv

!start-witness/
start-witness/*
!start-witness/summary.csv
!start-witness/metadata.csv
!start-witness/unresolved_inventory.csv
!start-witness/fits.csv

!start-development/
start-development/*
!start-development/summary.csv
!start-development/metadata.csv
!start-development/references.csv
!start-development/coverage.csv
!start-development/coverage_summary.csv

!start-fresh/
start-fresh/*
!start-fresh/summary.csv
!start-fresh/metadata.csv
!start-fresh/references.csv
!start-fresh/coverage.csv
!start-fresh/coverage_summary.csv

!expanded-families/
expanded-families/*
!expanded-families/summary.csv
!expanded-families/coverage.csv
!expanded-families/references.csv
!expanded-families/metadata.csv
!expanded-families/labels.csv

# Frozen direct ordinary-chart transfer evidence; full fits/starts stay local.
!direct-starts-information/
direct-starts-information/*
!direct-starts-information/summary.csv
!direct-starts-information/paired.csv
!direct-starts-information/references.csv
!direct-starts-information/metadata.csv
!direct-starts-information/labels.csv

# Small exact-geometry witness records and fresh PSD summaries are frozen evidence.
!geometry-witnesses/
geometry-witnesses/*
!geometry-witnesses/fits.csv
!geometry-witnesses/summary.csv
!geometry-witnesses/nonattainment_sequence.csv
!geometry-witnesses/metadata.csv
!psd-fresh/
psd-fresh/*
!psd-fresh/summary.csv
!psd-fresh/paired.csv
!psd-fresh/references.csv
!psd-fresh/metadata.csv
!psd-fresh/labels.csv

# Identification/continuation evidence; full search fits and covariance traces stay local.
!unresolved-identifications/
unresolved-identifications/*
!unresolved-identifications/tasks.csv
!unresolved-identifications/summary.csv
!unresolved-identifications/metadata.csv
!unresolved-identifications/continuation.csv
!unresolved-identifications/candidate_evidence.csv
!unresolved-identifications/candidate_parameters.csv
!unresolved-identifications/candidate_covariances.csv

# Translation-only inspection of saved spherical endpoints, including failed local checks.
!sphere-translations-inspected/
sphere-translations-inspected/*
!sphere-translations-inspected/summary.csv
!sphere-translations-inspected/parameters.csv
!sphere-translations-inspected/sphere_parameters.csv
!sphere-translations-inspected/source_endpoints.csv
!sphere-translations-inspected/metadata.csv

# Required-failure witness; explicit study tolerance, no production default change.
!requested-chart-policy/
requested-chart-policy/*
!requested-chart-policy/endpoint_checks.csv

# Small independent high-precision witnesses, inputs and profiles; progress logs stay local.
!open-case-inputs/
open-case-inputs/*
!open-case-inputs/cases.csv
!open-case-inputs/moments.csv
!open-case-inputs/starts.csv
!open-case-refinement/
open-case-refinement/*
